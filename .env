# LexEnergy Bolivia - Environment Configuration

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=lexenergy_bolivia
QDRANT_API_KEY=

# Embeddings
EMBEDDINGS_MODEL=BAAI/bge-m3
EMBEDDINGS_DIMENSIONS=1024
EMBEDDINGS_DEVICE=cpu

# Reranker
RERANKER_MODEL=BAAI/bge-reranker-large
RERANKER_DEVICE=cpu

# LLM
LLM_MODEL=llama3.1
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# LangChain
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=

# Neo4j (future)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_DEBUG=false

# Ingestion
CORPUS_RAW_PATH=./corpus/raw
CORPUS_PROCESSED_PATH=./corpus/processed
CORPUS_NORMALIZED_PATH=./corpus/normalized

# Retrieval
TOP_K=10
BM25_TOP_K=20
DENSE_TOP_K=20
FINAL_TOP_K=5
RERANKER_TOP_K=5

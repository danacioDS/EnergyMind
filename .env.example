# Qdrant Cloud
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=energymind
QDRANT_USE_CLOUD=true

# LLM Providers
GROQ_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Redis
REDIS_URL=

# Embeddings
EMBEDDINGS_MODEL=all-MiniLM-L6-v2
EMBEDDINGS_DIMENSIONS=384
EMBEDDINGS_DEVICE=cpu

# Retrieval
TOP_K=10
BM25_TOP_K=50
DENSE_TOP_K=50
FINAL_TOP_K=5
HYBRID_ALPHA=0.5

# CORS
FRONTEND_ORIGINS=["https://energymind.vercel.app","http://localhost:3000"]
